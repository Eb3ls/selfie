# MongoDB connection string (MongoDB Atlas or local instance)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/selfie

# Secret used to sign JWT session tokens (any random string, min 32 chars)
SECRET_KEY=your_jwt_secret_here

# Gmail account used by Nodemailer to send verification and notification emails
# Use a Gmail App Password, not your regular account password:
# https://myaccount.google.com/apppasswords
GMAIL_EMAIL=your_email@gmail.com
GMAIL_PASSWORD=your_gmail_app_password

# VAPID keys for web push notifications
# Generate them by running: node generate_vapid_keys.js
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
NEXT_PUBLIC_VAPID_PRIVATE_KEY=your_vapid_private_key
